# Copy this file:  cp .env.example .env
# Then put YOUR Aiven service username and password in .env
# Never commit .env

PORT=3000

# Aiven MySQL: host/port/database/ssl come from your Aiven service page
DB_HOST=your-service-host.aivencloud.com
DB_PORT=12345
DB_NAME=defaultdb
DB_SSL=REQUIRED

# YOUR service user (Aiven → Users → Create service user)
DB_USER=your_aiven_username
DB_PASS=your_aiven_password